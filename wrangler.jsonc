{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ebrahim-vpn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "14eee4f0-7a0a-4728-89d9-ed6ef9f4f8dd","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "77ff320d8a2449888ad9f1fd7f0ca684" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
